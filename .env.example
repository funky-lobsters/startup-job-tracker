# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is ignored by git, so your secrets stay on your computer. Never commit it.

# Turn on Django's debug pages locally. Must be false on Render.
DEBUG=true

# Any long random string. Locally you can leave this; Render generates its own.
SECRET_KEY=change-me-to-a-long-random-string

# Neon DEV database connection string (Neon > your dev project > Connect).
# Use the direct connection (turn "Connection pooling" off). Keep ?sslmode=require at the end.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Optional: run the tests against Postgres instead of the built-in SQLite test database.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Later (Sprint 2): OpenRouter key for the AI feature. Never commit the real key.
# OPENROUTER_API_KEY=sk-or-...
